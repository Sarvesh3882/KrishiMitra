# KrishiMitra Backend Environment Variables
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit real .env files to version control

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key — SERVER-SIDE ONLY, never expose in frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mappls (MapmyIndia) API Access Token
# Get your access token from: https://about.mappls.com/api/
# This is used for finding nearby selling points
MAPPLS_ACCESS_TOKEN=your-mappls-access-token-here

# ============================================
# AI Services API Keys (SERVER-SIDE ONLY)
# ============================================

# Sarvam AI API Key
# Get from: https://www.sarvam.ai/
# Used for: Speech-to-Text (Saaras), Text-to-Speech (Bulbul)
SARVAM_API_KEY=your-sarvam-api-key-here

# Sarvam STT Model (optional, defaults to saaras:v3)
# Recommended: saaras:v3
# Options: saaras:v3, saaras:v4, saaras:v4-multispk
SARVAM_STT_MODEL=saaras:v3

# Sarvam TTS Model (optional, defaults to bulbul:v3)
# Recommended: bulbul:v3
# Options: bulbul:v2, bulbul:v3, bulbul:v3-beta
SARVAM_TTS_MODEL=bulbul:v3

# Sarvam TTS Speaker (optional, defaults to shubh)
# Official default for bulbul:v3 is "shubh" (male voice)
# Valid bulbul:v3 speakers (lowercase, case-sensitive):
# Male: shubh, aditya, rahul, rohan, amit, dev, ratan, varun, manan, sumit, 
#       kabir, aayan, ashutosh, advait, anand, tarun, sunny, mani, gokul, 
#       vijay, mohit, rehan, soham
# Female: ritu, priya, neha, pooja, simran, kavya, ishita, shreya, roopa, 
#         tanya, shruti, suhani, kavitha, rupali
SARVAM_TTS_SPEAKER=shubh

# Mistral AI Configuration
# Get from: https://console.mistral.ai/
# CRITICAL: Use the specific Agent created in Mistral Studio
# Do NOT use generic chat/completions - use the Agent API
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_AGENT_ID=your-mistral-agent-id-here

# Edge Function secrets (set via Supabase CLI, not in this file):
# KISANSLM_API_URL=https://your-kisanslm-endpoint
# ANTHROPIC_API_KEY=sk-ant-...   (fallback LLM — server-side only)

